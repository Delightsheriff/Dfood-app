# Dfood App Environment Configuration
#
# No environment variables are strictly required to run the app.
# By default, the app runs in full offline/local-first mode using OpenStreetMap Overpass,
# TheMealDB, and local AsyncStorage state.
#
# Optional: Firebase Authentication & Cloud Sync
# To enable multi-device sync and authentication, provide the following Firebase project keys:
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
